From 2fef20407d1dd8e8bbb444a644dfc9d1189e178c Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sun, 8 Nov 2026 19:32:14 +0000
Subject: [PATCH] 0009 closed-lib link stubs

---
 osfmk/arm/pmap/pmap_misc.c           |  8 ++++++++
 osfmk/arm64/caches_asm.s             | 14 ++++++++++++++
 osfmk/arm64/lapis_closed_lib_stubs.c | 16 ++++++++++++++++
 osfmk/arm64/machine_routines.c       | 13 +++++++++++++
 osfmk/conf/files.arm64               |  3 +++
 5 files changed, 54 insertions(+)
 create mode 100644 osfmk/arm64/lapis_closed_lib_stubs.c

diff --git a/osfmk/arm/pmap/pmap_misc.c b/osfmk/arm/pmap/pmap_misc.c
index dacf3b5..1d8b17e 100644
--- a/osfmk/arm/pmap/pmap_misc.c
+++ b/osfmk/arm/pmap/pmap_misc.c
@@ -39,6 +39,14 @@
  */
 
 
+#if SCHED_HYGIENE_DEBUG && (DEVELOPMENT || DEBUG) && !XNU_MONITOR
+bool
+pmap_pending_preemption(void)
+{
+	return _pmap_pending_preemption_real();
+}
+#endif /* SCHED_HYGIENE_DEBUG && (DEVELOPMENT || DEBUG) && !XNU_MONITOR */
+
 void
 pmap_abandon_measurement(void)
 {
diff --git a/osfmk/arm64/caches_asm.s b/osfmk/arm64/caches_asm.s
index 1588830..a68b245 100644
--- a/osfmk/arm64/caches_asm.s
+++ b/osfmk/arm64/caches_asm.s
@@ -354,6 +354,20 @@ LEXT(CleanPoC_DcacheRegion_Force)
 	b		EXT(CleanPoC_DcacheRegion_internal)
 #endif /* APPLE_ARM64_ARCH_FAMILY */
 
+#if !defined(APPLE_ARM64_ARCH_FAMILY)
+/*
+ *	Generic ARMv8: Apple's HID-toggling nopreempt variants collapse to the
+ *	plain region clean used by CleanPoC_DcacheRegion_Force above.
+ */
+	.text
+	.align 2
+	.globl EXT(CleanPoC_DcacheRegion_Force_nopreempt)
+	.globl EXT(CleanPoC_DcacheRegion_Force_nopreempt_nohid)
+LEXT(CleanPoC_DcacheRegion_Force_nopreempt)
+LEXT(CleanPoC_DcacheRegion_Force_nopreempt_nohid)
+	b		EXT(CleanPoC_DcacheRegion_internal)
+#endif /* !APPLE_ARM64_ARCH_FAMILY */
+
 /*
  *	void FlushPoC_Dcache(void)
  *
diff --git a/osfmk/arm64/lapis_closed_lib_stubs.c b/osfmk/arm64/lapis_closed_lib_stubs.c
new file mode 100644
index 0000000..0f5dc20
--- /dev/null
+++ b/osfmk/arm64/lapis_closed_lib_stubs.c
@@ -0,0 +1,16 @@
+/*
+ * Symbols Apple ships only in the closed per-SoC / Tightbeam stack.
+ * Empty/no-op bodies so MACHINE_CONFIG=LAPIS can link.
+ */
+#include <mach/boolean.h>
+
+#if defined(LAPIS)
+
+void tb_transport_startup(void);
+
+void
+tb_transport_startup(void)
+{
+}
+
+#endif /* LAPIS */
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 07143d5..e9d9712 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2622,6 +2622,19 @@ ml_get_decrementer(void)
 	return dec;
 }
 
+#if defined(LAPIS)
+void
+ml_enable_monitor(void)
+{
+}
+
+boolean_t
+ml_device_is_prod_fused(void)
+{
+	return FALSE;
+}
+#endif /* LAPIS */
+
 boolean_t
 ml_get_timer_pending(void)
 {
diff --git a/osfmk/conf/files.arm64 b/osfmk/conf/files.arm64
index 878b515..96a1929 100644
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
@@ -129,3 +129,6 @@ osfmk/kern/ecc_init.c		standard
 osfmk/kern/ecc_logging.c	optional config_ecc_logging
 
 osfmk/kern/memory_error_logging.c	standard
+
+# LAPIS closed-lib / Tightbeam stubs (empty TU without LAPIS)
+osfmk/arm64/lapis_closed_lib_stubs.c		standard
