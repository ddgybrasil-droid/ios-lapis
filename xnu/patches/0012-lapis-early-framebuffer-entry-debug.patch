diff --git a/osfmk/arm64/lapis_early.c b/osfmk/arm64/lapis_early.c
new file mode 100644
index 0000000..5313de2
--- /dev/null
+++ b/osfmk/arm64/lapis_early.c
@@ -0,0 +1,135 @@
+/*
+ * lapis bootstrap console on the ABL splash framebuffer.
+ * No allocation/locks/ADT: reachable from panic before a current thread exists.
+ * start.s maps FB VA=PA as Normal Non-Cacheable in the V=P L2 table.
+ * Disable before arm_vm_init tears down bootstrap TTBR0.
+ */
+#include <arm64/lapis_early.h>
+
+#if defined(LAPIS)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+/* M0-verified splash: XRGB8888, 2944x1840, stride 11776. */
+#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0xD5100000ULL)
+#define EARLY_WIDTH 2944u
+#define EARLY_HEIGHT 1840u
+#define EARLY_STRIDE (11776u / 4u)
+#define EARLY_SCALE 3u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 48u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+lapis_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff001010u;
+		}
+	}
+}
+
+void
+lapis_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		lapis_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		lapis_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (0x80u >> gx)) ? 0xffffffffu : 0xff001010u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+lapis_early_string(const char *s)
+{
+	while (*s) {
+		lapis_early_putc(*s++);
+	}
+}
+
+void
+lapis_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 9) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | ((stage * 24u) << 16) | ((9u - stage) * 20u);
+	unsigned int x0 = stage * 96u;
+	unsigned int x1 = x0 + 96u;
+	if (x1 > EARLY_WIDTH) {
+		x1 = EARLY_WIDTH;
+	}
+	for (unsigned int y = EARLY_HEIGHT - 48; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = x0; x < x1; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	lapis_early_string("LAPIS EARLY ");
+	lapis_early_putc((char)('0' + stage));
+	lapis_early_string(": ");
+	lapis_early_string(label);
+	lapis_early_putc('\n');
+}
+
+void
+lapis_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	lapis_early_string("\nLAPIS EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, lapis_early_putc, 16);
+	va_end(copy);
+	lapis_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+lapis_early_disable(void)
+{
+	lapis_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* LAPIS */
diff --git a/osfmk/arm64/lapis_early.h b/osfmk/arm64/lapis_early.h
new file mode 100644
index 0000000..c14daee
--- /dev/null
+++ b/osfmk/arm64/lapis_early.h
@@ -0,0 +1,22 @@
+/* Early splash-FB diagnostics while bootstrap TTBR0 V=P is live (LAPIS). */
+#ifndef _ARM64_LAPIS_EARLY_H_
+#define _ARM64_LAPIS_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(LAPIS)
+void lapis_early_mark(unsigned int stage, const char *label);
+void lapis_early_putc(char c);
+void lapis_early_panic(const char *fmt, va_list *args);
+void lapis_early_disable(void);
+#else
+static inline void lapis_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void lapis_early_disable(void) {}
+#endif
+
+#endif /* _ARM64_LAPIS_EARLY_H_ */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index ca003c8..72f634b 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -126,8 +126,9 @@ LEXT(LowResetVectorBase)
