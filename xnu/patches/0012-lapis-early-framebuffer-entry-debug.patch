 #if !(defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR))
@@ -242,6 +243,94 @@ LEXT(_start)
 	.align 12, 0
 	.global	EXT(LowExceptionVectorBase)
 LEXT(LowExceptionVectorBase)
+#if defined(LAPIS)
+	mov		x9, #0
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #1
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #2
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #3
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #4
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #5
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #6
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #7
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #8
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #9
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #10
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #11
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #12
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #13
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #14
+	b		lapis_low_exc
+	.align	7
+	mov		x9, #15
+	b		lapis_low_exc
+	.align	2
+lapis_low_exc:
+	MOV64	x0, 0xD5100000
+MOV64	x1, 0xff0000a0
+	MOV64	x2, (2944 * 128)
+1:	str		w1, [x0], #4
+	subs	x2, x2, #1
+	b.ne	1b
+	mrs		x3, ESR_EL1
+	mrs		x4, ELR_EL1
+	mrs		x5, FAR_EL1
+	MOV64	x0, (0xD5100000 + 200 * 11776)
+MOV64	x1, 0xffffff00
+	add		x2, x0, x9, lsl #6
+	str		w1, [x2]
+MOV64	x1, 0xff00ff00
+	and		x2, x3, #0xff
+	add		x2, x0, x2, lsl #2
+	add		x2, x2, #1024
+	str		w1, [x2]
+MOV64	x1, 0xffff00ff
+	lsr		x2, x3, #26
+	and		x2, x2, #0x3f
+	add		x2, x0, x2, lsl #3
+	add		x2, x2, #2048
+	str		w1, [x2]
+	MOV64	x0, (0xD5100000 + 220 * 11776)
+MOV64	x1, 0xff00ffff
+	and		x2, x4, #0xff
+	add		x2, x0, x2, lsl #2
+	str		w1, [x2]
+MOV64	x1, 0xffff8000
+	and		x2, x5, #0xff
+	add		x2, x0, x2, lsl #2
+	add		x2, x2, #1024
+	str		w1, [x2]
+	dsb		sy
+2:	wfe
+	b		2b
+#else
 	/* EL1 SP 0 */
 	b		.
 	.align	7
@@ -277,6 +366,7 @@ LEXT(LowExceptionVectorBase)
 	b		.
 	.align	7
 	b		.
+#endif /* LAPIS */
 	.align 12, 0
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR)
@@ -467,13 +557,32 @@ start_cpu:
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
-	// Unlock the core for debugging
-	msr		OSLAR_EL1, xzr
-	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
-
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(LAPIS)
+	MOV64	x0, 0xD5100000
+	mov		w1, #-1
+	mov		x2, #48
+Llapis_s0_row:
+	mov		x3, #160
+	mov		x5, x0
+Llapis_s0_px:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Llapis_s0_px
+	MOV64	x4, 11776
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Llapis_s0_row
+	dsb		sy
+#endif
+
+#if !defined(LAPIS)
+	msr		OSLAR_EL1, xzr
+#endif
+	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -620,6 +729,30 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(LAPIS)
+	MOV64	x10, 0xD5100000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	MOV64	x0, (0xD5100000 + 64 * 11776)
+MOV64	x1, 0xff80ff00
+	mov		x2, #32
+Llapis_s1_row:
+	mov		x3, #160
+	mov		x5, x0
+Llapis_s1_px:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Llapis_s1_px
+	MOV64	x4, 11776
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Llapis_s1_row
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -747,11 +880,47 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+#if defined(LAPIS)
+	MOV64	x0, (0xD5100000 + 112 * 11776)
+MOV64	x1, 0xff00ffff
+	mov		x2, #32
+Llapis_s2_row:
+	mov		x3, #160
+	mov		x5, x0
+Llapis_s2_px:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Llapis_s2_px
+	MOV64	x4, 11776
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Llapis_s2_row
+	dsb		sy
+#endif
+
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(LAPIS)
+	MOV64	x0, (0xD5100000 + 160 * 11776)
+MOV64	x1, 0xffff00ff
+	mov		x2, #32
+Llapis_s3_row:
+	mov		x3, #160
+	mov		x5, x0
+Llapis_s3_px:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Llapis_s3_px
+	MOV64	x4, 11776
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Llapis_s3_row
+	dsb		sy
+#endif
+
 #if !VMAPPLE && !defined(LAPIS)
 	MOV64	x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
