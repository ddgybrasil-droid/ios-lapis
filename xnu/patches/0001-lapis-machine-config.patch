 pexpert/pexpert/arm64/board_config.h | 13 ++++++
 6 files changed, 100 insertions(+), 4 deletions(-)
 create mode 100644 pexpert/pexpert/arm64/LAPIS.h

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index e37762b..2538294 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE LAPIS
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -93,6 +93,7 @@ MACHINE_FLAGS_ARM64_T8132 = -DARM64_BOARD_CONFIG_T8132			-mcpu=apple-m4
 MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+predres2
 
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
+MACHINE_FLAGS_ARM64_LAPIS = -DARM64_BOARD_CONFIG_LAPIS                -march=armv8.2-a+crypto
 
 
 #
@@ -370,8 +371,10 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 # Without embdedded device map, use a default arch string
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
+ifneq ($(CURRENT_MACHINE_CONFIG),LAPIS)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
+endif
 
 endif
 
@@ -1152,8 +1155,10 @@ LD_KERNEL_ARCHIVES = $(LDFLAGS_KERNEL_SDK) -lfirehose_kernel
 
 # Link binary support library
 ifneq ($(CURRENT_MACHINE_CONFIG),NONE)
+ifneq ($(CURRENT_MACHINE_CONFIG),LAPIS)
         LDFLAGS_KERNEL_ONLY += -rdynamic -Wl,-force_load,$(KDKROOT)/System/Library/KernelSupport/lib$(CURRENT_MACHINE_CONFIG).os.$(CURRENT_KERNEL_CONFIG).a
 endif
+endif
 
 #
 # Derive SPTM/TXM and Exclaves enablement from the EDM properties.
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index f4d148b..8c9e728 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -243,6 +243,15 @@
 /* D-Cache, 128KB for Acc8 PCore, 8-way. 64KB for ECore, 8-way. */
 #define MMU_CLINE   6                      /* cache line size is 1<<MMU_CLINE (64) */
 
+
+#elif defined (LAPIS) /* Qualcomm SM8650: Cortex-A520/A720/X4 */
+
+/* I-Cache. */
+#define MMU_I_CLINE 6
+
+/* D-Cache. */
+#define MMU_CLINE   6
+
 #elif defined (VMAPPLE)
 
 /* I-Cache. */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 6aa6fe4..ca003c8 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -752,11 +752,11 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
-#if !VMAPPLE
+#if !VMAPPLE && !defined(LAPIS)
 	MOV64	x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
-#endif /* !VMAPPLE */
+#endif /* !VMAPPLE && !LAPIS */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
diff --git a/pexpert/pexpert/arm64/LAPIS.h b/pexpert/pexpert/arm64/LAPIS.h
new file mode 100644
index 0000000..3edf92d
--- /dev/null
+++ b/pexpert/pexpert/arm64/LAPIS.h
@@ -0,0 +1,68 @@
+/*
+ * Board config for Lenovo Yoga Pad Pro 12.7 ("lapis", TB520FU,
+ * Qualcomm SM8650 / Snapdragon 8 Gen 3).
+ *
+ * Generic ARM like ios-sweet's SWEET board: no APPLE_ARM64_ARCH_FAMILY
+ * (none of Apple's implementation-defined system registers exist), 16K
+ * pages and GICv3. Group 0 belongs to TrustZone/Gunyah; timer and IPIs
+ * are Group 1 IRQs taken through sleh_irq().
+ *
+ * GICR stride is 0x40000 on SM8650 (not 0x20000).
+ */
+
+#ifndef _PEXPERT_ARM64_LAPIS_H
+#define _PEXPERT_ARM64_LAPIS_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define LAPIS                     1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* SM8650 upstream DT: virt timer is PPI 11 => INTID 27. */
+#define LAPIS_VTIMER_INTID        27
+#define LAPIS_IPI_SGI             1
+
+#define GIC_SPURIOUS_IRQ          1023
+
+/* SM8650 redistributor-stride = 0x40000 */
+#define GICR_PE_SIZE              0x40000
+
+#define GICD_CTLR                 0x0
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+#define ICC_SRE_SRE                             0x1
+
+#endif /* ! _PEXPERT_ARM64_LAPIS_H */
diff --git a/pexpert/pexpert/arm64/Makefile b/pexpert/pexpert/arm64/Makefile
index 75938b5..e55c00b 100644
--- a/pexpert/pexpert/arm64/Makefile
+++ b/pexpert/pexpert/arm64/Makefile
@@ -33,7 +33,8 @@ PRIVATE_KERNELFILES = \
 	H15.h \
 	H16.h \
 	H17.h \
-	VMAPPLE.h
+	VMAPPLE.h \
+	LAPIS.h
 
 
 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 5a6cd33..c99ced0 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -304,6 +304,19 @@
 
 
 
+
+#ifdef ARM64_BOARD_CONFIG_LAPIS
+#include <pexpert/arm64/LAPIS.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               1
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_LAPIS */
+
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
